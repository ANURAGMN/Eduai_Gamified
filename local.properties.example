# Copy to local.properties and fill in real values (local.properties is gitignored).

sdk.dir=C\:\\Users\\YOUR_USER\\AppData\\Local\\Android\\Sdk

# --- Release signing (required for bundleRelease / Play upload) ---
# Generate once: keytool -genkey -v -keystore eduai-upload.jks -keyalg RSA -keysize 2048 -validity 10000 -alias eduai
# Path is relative to the app/ module (use ../ for project root)
KEYSTORE_PATH=../eduai-upload.jks
KEYSTORE_PASSWORD=your_keystore_password
KEY_ALIAS=eduai
KEY_PASSWORD=your_key_password

# --- AdMob (production) ---
# Create at https://admob.google.com → Apps → EduAI → Ad units → Banner
# Link to Firebase project eduai-e090e for revenue analytics.
# Console checklist: scripts/admob-firebase-setup.md
# Verify locally: .\scripts\verify-admob-config.ps1
ADMOB_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY
BANNER_AD_UNIT_ID=ca-app-pub-XXXXXXXXXXXXXXXX/ZZZZZZZZZZ
REWARDED_AD_UNIT_ID=ca-app-pub-XXXXXXXXXXXXXXXX/RRRRRRRRRR

# Optional: hashed test device ID from logcat — debug builds ONLY (release AAB ignores this)
ADMOB_TEST_DEVICE_ID=

# --- Gamification (Sprint 1+) ---
# Set true to enable the ui-kit Home for all builds using this local.properties
GAMIFIED_HOME_ENABLED=false

# --- Backend & AI (required for full app functionality) ---
# EC2 FastAPI agent — see docs/APP_STRUCTURE.md §11 (SSH, health, region)
AUTH_KEY=
AGENTIC_AI_BASE_URL=http://13.48.59.144:8000
GEMINI_API_KEY=
GROQ_API_KEY=
SIMULATION_BASE_URL=
API_KEYS=
API_KEY_HEADER_NAME=

# --- Padaams in-app sign-in (Play review / @padaams.in accounts) ---
# Shown on login when set. Use check@padaams.in + this password in Play Console Sign-in details.
PADAAMS_SIGNIN_PASSWORD=
