rules_version = '2';

// EduAI — rollback rules (eduai-e090e).
//
// TEMPORARY: Restores pre–Firebase Auth access so Play Store 1.0.8 clients can
// login and sync. Clients scope writes by doc path + appName field.
//
// TODO: Re-deploy auth-gated rules after Play min version includes
// FirebaseAuthBridge (1.0.11+ / versionCode 13+).

service cloud.firestore {
  match /databases/{database}/documents {

    function isEduAiAppDoc(docId) {
      return docId.matches('eduai_app_.+');
    }

    function eduAiStudentDocId(studentId) {
      return 'eduai_app_' + studentId;
    }

    function isEduAiWrite() {
      return request.resource.data.appName == 'eduai_app';
    }

    function studentIdMatchesParent(parentDocId) {
      return isEduAiWrite()
        && request.resource.data.keys().hasAll(['studentId'])
        && parentDocId == eduAiStudentDocId(request.resource.data.studentId);
    }

    // NCERT syllabus content — read-only from clients
    match /Concept/{conceptId} {
      allow read: if true;
      allow write: if false;
    }

    // Curated YouTube lessons — public read
    match /youtube_videos/{videoId} {
      allow read: if true;
      allow write: if false;
    }

    // User profile — open read for legacy clients without Firebase Auth
    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.resource.data.appName == 'eduai_app';
      allow delete: if false;
    }

    match /progress/{parentDoc}/records/{recordId} {
      allow read: if isEduAiAppDoc(parentDoc);
      allow create, update: if isEduAiAppDoc(parentDoc) && studentIdMatchesParent(parentDoc);
      allow delete: if false;
    }

    match /analytics/{parentDoc}/events/{eventId} {
      allow read: if isEduAiAppDoc(parentDoc);
      allow create, update: if isEduAiAppDoc(parentDoc) && studentIdMatchesParent(parentDoc);
      allow delete: if false;
    }

    match /sessions/{parentDoc}/records/{sessionId} {
      allow read: if isEduAiAppDoc(parentDoc);
      allow create, update: if isEduAiAppDoc(parentDoc) && studentIdMatchesParent(parentDoc);
      allow delete: if false;
    }

    match /streak/{parentDoc}/data/{docId} {
      allow read: if isEduAiAppDoc(parentDoc);
      allow create, update: if isEduAiAppDoc(parentDoc) && studentIdMatchesParent(parentDoc);
      allow delete: if false;
    }

    match /garden/{parentDoc}/state/{docId} {
      allow read: if isEduAiAppDoc(parentDoc);
      allow create, update: if isEduAiAppDoc(parentDoc) && studentIdMatchesParent(parentDoc);
      allow delete: if false;
    }

    match /garden/{parentDoc}/items/{itemId} {
      allow read: if isEduAiAppDoc(parentDoc);
      allow create, update: if isEduAiAppDoc(parentDoc) && studentIdMatchesParent(parentDoc);
      allow delete: if false;
    }

    match /gamification/{parentDoc}/profile/{docId} {
      allow read: if isEduAiAppDoc(parentDoc);
      allow create, update: if isEduAiAppDoc(parentDoc) && studentIdMatchesParent(parentDoc);
      allow delete: if false;
    }

    match /exam_plans/{parentDoc}/current/{docId} {
      allow read: if isEduAiAppDoc(parentDoc);
      allow create, update: if isEduAiAppDoc(parentDoc) && studentIdMatchesParent(parentDoc);
      allow delete: if false;
    }

    match /exam_plans/{parentDoc}/days/{dayId} {
      allow read: if isEduAiAppDoc(parentDoc);
      allow create, update: if isEduAiAppDoc(parentDoc) && studentIdMatchesParent(parentDoc);
      allow delete: if false;
    }

    match /quests/{parentDoc}/daily/{questDate} {
      allow read: if isEduAiAppDoc(parentDoc);
      allow create, update: if isEduAiAppDoc(parentDoc) && studentIdMatchesParent(parentDoc);
      allow delete: if false;
    }

    match /chapterprogress/{parentDoc}/records/{recordId} {
      allow read: if isEduAiAppDoc(parentDoc);
      allow create, update: if isEduAiAppDoc(parentDoc) && studentIdMatchesParent(parentDoc);
      allow delete: if false;
    }

    match /errors/{appName}/logs/{logId} {
      allow read: if false;
      allow create: if appName == 'eduai_app'
        && request.resource.data.appName == 'eduai_app';
      allow update, delete: if false;
    }

    match /simulation_interactions/{studentId}/daily/{date} {
      allow read: if true;
      allow create, update: if isEduAiWrite()
        && request.resource.data.studentId == studentId;
      allow delete: if false;
    }

    match /friend_codes/{code} {
      allow read: if true;
      allow create, update: if isEduAiWrite()
        && !request.resource.data.keys().hasAny(['displayName', 'email', 'phoneNumber']);
      allow delete: if false;
    }

    match /friends/{parentDoc}/connections/{friendStudentId} {
      allow read: if isEduAiAppDoc(parentDoc);
      allow create, update: if isEduAiAppDoc(parentDoc)
        && isEduAiWrite()
        && request.resource.data.keys().hasAll(['studentId', 'friendStudentId'])
        && parentDoc == eduAiStudentDocId(request.resource.data.studentId)
        && request.resource.data.friendStudentId == friendStudentId;
      allow delete: if false;
    }

    match /friends/{parentDoc}/feed/{eventKey} {
      allow read: if isEduAiAppDoc(parentDoc);
      allow create, update: if isEduAiAppDoc(parentDoc)
        && isEduAiWrite()
        && request.resource.data.keys().hasAll(['ownerStudentId', 'eventKey'])
        && parentDoc == eduAiStudentDocId(request.resource.data.ownerStudentId)
        && request.resource.data.eventKey == eventKey;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
