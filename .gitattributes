* text=auto eol=lf

# Windows scripts may keep CRLF locally
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.jar binary
*.apk binary
*.aab binary
*.keystore binary
*.jks binary
