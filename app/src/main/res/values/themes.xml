<resources>
    <style name="Theme.EduAI" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- WebView algorithmic darkening keys off isLightTheme. Keep true so light-only sims
             (white text on purple headers) are not inverted into white-on-white in system dark mode. -->
        <item name="android:isLightTheme">true</item>
        <item name="android:forceDarkAllowed">false</item>
        <!-- Remove status bar color - let Compose handle it -->
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/black</item>
        <item name="colorPrimaryVariant">@color/black</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
    </style>
</resources>